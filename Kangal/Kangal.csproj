<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Kangal</AssemblyName>
    <RootNamespace>Kangal</RootNamespace>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Selçuk Güral</Authors>
    <Company>Selçuk Güral</Company>
    <Description>Kangal is extension library for data operations. Like DataReader, SqlConnection or DataTable.</Description>
    <Copyright>Selçuk Güral</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/selcukgural/Kangal</PackageProjectUrl>
    <PackageIcon>24x.png</PackageIcon>
    <RepositoryUrl>https://github.com/selcukgural/Kangal</RepositoryUrl>
    <PackageTags>Extension, DataTable, SqlConnection, List, Csv, Json</PackageTags>
    <Nullable>enable</Nullable>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0</AssemblyVersion>
    <FileVersion>2.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="images\24x.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

</Project>
